# === Gehirn ===
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# === Telegram ===
TELEGRAM_BOT_TOKEN=123456:ABC...

# === Stimme / TTS (Eva spricht zurueck) ===
# ElevenLabs-Key holen: elevenlabs.io -> Profil -> API Key. Free-Tier reicht zum Testen.
ELEVENLABS_API_KEY=
# Optional: eigene (deutsche) Stimme in ElevenLabs waehlen und die Voice-ID hier eintragen.
ELEVENLABS_VOICE_ID=
# Optional: eleven_multilingual_v2 (Qualitaet, Default) oder eleven_turbo_v2_5 (schneller/guenstiger)
ELEVENLABS_MODEL=
# Optional: elevenlabs (Default) | piper (spaeter, self-hosted, gratis)
TTS_PROVIDER=

# === Kalender (geheime iCal-URLs aus Google/Outlook) ===
PRIVAT_GOOGLE_ICS_URL=
FAMILIE_GOOGLE_ICS_URL=
PROJEKTE_GOOGLE_ICS_URL=
OUTLOOK_ICS_URL=

# === E-Mail (Sammel-Prinzip; App-Passwoerter, nicht das normale Login) ===
MAIL_1_USER=haupt@gmail.com
MAIL_1_PASS=
MAIL_2_USER=nadine.iva.inbox@gmail.com
MAIL_2_PASS=

# === CRM HeatHero (Arbeit) ===
HEATHERO_API_KEY=hh_live_...

# === CRM "Mein CRM" (privat) - Supabase service_role + Projekt-IDs ===
MEINCRM_SERVICE_KEY=eyJ...
HEATHERO_PROJECT_ID=
GOALS_CONCEPTS_PROJECT_ID=
KOOP_STEUERBERATER_PROJECT_ID=
SOL_PROJECT_ID=
VERSURO_PROJECT_ID=

# === Calendly ===
CALENDLY_TOKEN=

# === Marketing-Maschine (Apify-Scraper + Bild-Generierung) ===
APIFY_TOKEN=apify_api_...
FAL_KEY=fal-...
# Google Places Text Search fuer Branchen-/Firmensuche. In Google Cloud nur Places API (New) aktivieren und den Key auf die Railway-Domain/IP-Nutzung begrenzen.
GOOGLE_PLACES_API_KEY=
# Eigene Meta-Konten: Publishing + Ads Insights/Management. Konkurrenz-Ads werden ueber die oeffentliche Ad Library bzw. einen freigegebenen Research-Actor geprueft.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_GRAPH_VERSION=
META_PAGE_ID=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# Eigene LinkedIn-Organisation (offizielle API liefert nicht frei den gesamten Wettbewerber-Feed).
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# UGC-/Avatar-Video erst nach Skriptfreigabe.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
# Fuer Kampagnenversand einen Provider waehlen und die Absenderdomain dort verifizieren.
BREVO_API_KEY=
# RESEND_API_KEY=
# Taeglichen Marketing-Entscheidungsreport um 07:10 Uhr per Telegram senden.
MARKETING_MORNING_REPORT_ENABLED=false

# === Web-Research-Agent ===
# Tavily Search API. Free-Tier ~1000 Suchen/Monat, kein Kreditkarten-Zwang.
# Holen: tavily.com -> Sign up -> API Keys.
TAVILY_API_KEY=tvly-...

# === Frontend-API (gleicher Wert wie in der Lovable-App) ===
API_TOKEN=langer-zufallswert-ausdenken

# === Qonekto / blau direkt (MCP) ===
# Railway-Variable mit einem Qonekto-MCP-Token. IVA liest direkt; Aenderungen brauchen eine exakte zweite Bestaetigung. Destruktive Aktionen bleiben gesperrt.
QONEKTO_MCP_TOKEN=
# Optional: nur aendern, wenn sich der offizielle Qonekto-Endpunkt aendert.
QONEKTO_MCP_URL=https://app.qonekto.de/api/goalsandconcepts/mcp

# === CRM -> Qonekto Kundenanlage ===
# Erst nach einem kontrollierten Test auf true setzen. Dann werden Goals-&-Concepts-Leads
# im Status Strategiegespraech alle 5 Minuten per Upsert bei Qonekto/blau direkt angelegt bzw. aktualisiert.
CRM_QONEKTO_SYNC_ENABLED=false
CRM_QONEKTO_SYNC_STAGE=Strategiegespräch
# Optional, falls diese IDs nicht bereits am CRM-Lead stehen bzw. Qonekto keinen Standard setzt.
CRM_QONEKTO_DEFAULT_SALUTATION_ID=
CRM_QONEKTO_DEFAULT_BROKER_ID=

# === WhatsApp Business Platform ===
# Meta-Systemnutzer-Token, nicht ein persoenliches Facebook-Passwort.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Frei gewaehlter geheimer String fuer die einmalige Webhook-Verifikation.
WHATSAPP_VERIFY_TOKEN=
# App-Secret der Meta-App; prueft jede eingehende Webhook-Signatur.
WHATSAPP_APP_SECRET=
# Bewusst explizit setzen, damit ein Graph-API-Upgrade nicht unbemerkt Verhalten aendert (z. B. v23.0).
WHATSAPP_GRAPH_VERSION=
# Optionaler Fallback nur fuer interne Tests ohne eingehende Phone Number ID.
WHATSAPP_DEFAULT_PROFILE_ID=
# Optional: eigener Modell-Override fuer kurze WhatsApp-Antworten.
# IVA_MODEL_WHATSAPP=anthropic:claude-haiku-4-5-20251001

# === GKV-Vergleichsportal (vorbereitet, Anbieter spaeter festlegen) ===
# Anzeigename und sichere Start-/Deep-Link-URL des Vergleichsportals. Keine Zugangsdaten in die URL schreiben.
GKV_COMPARE_PROVIDER=
GKV_COMPARE_URL=

# Hinweis: PORT und RAILWAY_PUBLIC_DOMAIN setzt Railway automatisch.
